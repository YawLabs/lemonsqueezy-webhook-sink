{
  "name": "@yawlabs/lemonsqueezy-webhook-sink",
  "version": "0.2.3",
  "description": "Durable webhook receiver for LemonSqueezy — verifies signatures, deduplicates events, and persists them for replay and reconciliation",
  "license": "MIT",
  "author": "YawLabs <contact@yaw.sh>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YawLabs/lemonsqueezy-webhook-sink.git"
  },
  "homepage": "https://github.com/YawLabs/lemonsqueezy-webhook-sink#readme",
  "bugs": {
    "url": "https://github.com/YawLabs/lemonsqueezy-webhook-sink/issues"
  },
  "keywords": [
    "lemonsqueezy",
    "webhook",
    "receiver",
    "reconciliation",
    "payments",
    "lemon-squeezy",
    "webhooks",
    "webhook-receiver",
    "hmac",
    "idempotency",
    "deduplication",
    "event-store",
    "sqlite"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lemonsqueezy-webhook-sink": "dist/index.js"
  },
  "files": [
    "dist/",
    "schema.sql"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test-timeout=300000 --test dist/*.test.js",
    "lint": "node scripts/lint.mjs check src/",
    "lint:fix": "node scripts/lint.mjs check --write src/",
    "prepublishOnly": "npm run build && node --test-timeout=300000 --test dist/*.test.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "better-sqlite3": "^12.9.0",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
